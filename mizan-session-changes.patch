+
+  useEffect(() => {
+    const load = async () => {
+      setLoading(true);
+      try {
+        const [profiles, attempts, articles, payments] = await Promise.all([
+          (supabase as any).from("profiles").select("id", { count: "exact", head: true }),
+          (supabase as any).from("quiz_attempts").select("id", { count: "exact", head: true }),
