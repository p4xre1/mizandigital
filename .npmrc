# ── 🛡️ Supply Chain Security ──
# Block lifecycle scripts from executing during installation
ignore-scripts=true

# ── 🚀 Performance & CLI DX ──
# Suppress funding notices after dependency installation
fund=false

# Suppress non-critical vulnerability audits during install
audit=false

# ── 💻 Engine Strictness ──
# Enforce Node.js engine version constraints specified in package.json
engine-strict=true

# ── ☁️ CI / Cloudflare ──
# Let CI refresh the lockfile if package.json and pnpm-lock.yaml drift.
frozen-lockfile=false
