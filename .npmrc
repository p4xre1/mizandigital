# ── 📦 Lockfile & Dependency Resolution ──
# Allow lockfile updates locally (enforce --frozen-lockfile in CI/CD commands)
frozen-lockfile=false

# Enforce Node.js engine version constraints specified in package.json
engine-strict=true

# Automatically resolve and install peer dependencies
auto-install-peers=true

# ── 🛡️ Supply Chain Security ──
# Block malicious lifecycle scripts from executing during installation
ignore-scripts=true

# ── 🚀 Performance & CLI DX ──
# Suppress funding notices after dependency installation
fund=false

# Suppress non-critical vulnerability audits during install to speed up build times
audit=false

# ── 💻 Cross-Platform Consistency ──
# Force LF line endings for generated lockfiles
line-ending=lf
