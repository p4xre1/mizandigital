# -----------------------------------------------------------------------------
# Environment Variables Blueprint (.env.example)
# Copy this file to .env.local and fill in your actual values.
# -----------------------------------------------------------------------------

# 🌐 1. CANONICAL URLS & DOMAINS
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME="ميزان الرقمية"

# 📊 2. ANALYTICS & MONETIZATION
VITE_GA_ID=
VITE_GTM_ID=
VITE_ADSENSE_CLIENT_ID=
VITE_GOOGLE_ADSENSE_CLIENT_ID=

# ⚡ 3. SUPABASE BACKEND
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_here

# ☁️ 4. CLOUDFLARE R2 CDN
# ⚠️ هذه المتغيرات (بلا بادئة VITE_) تُستخدم فقط داخل
# functions/api/r2/*.js (خادم Cloudflare Pages Function) ويجب ضبطها في
# لوحة Cloudflare Pages → Settings → Environment variables. لا تضعها أبداً
# فـ .env.local ولا فـ أي ملف يُقرأ بواسطة Vite (import.meta.env) لأن كل
# متغير بادئته VITE_ يُدمج داخل حزمة المتصفح العلنية.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mizan-cms-storage
R2_PUBLIC_DOMAIN=https://media.mizan.page

# متغيرات Supabase يحتاجها functions/api/r2/*.js أيضاً من جهة الخادم
# (نفس قيم VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY أعلاه — علنية أصلاً
# وليست سرّاً، لكن Cloudflare Pages Functions لا تقرأ متغيرات VITE_
# تلقائياً فيجب تكرارها بلا البادئة):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_here

# 🛡️ 5. SECURITY & CAPTCHA
#
# كل ما في هذا القسم "اختياري": الموقع يعمل بدونه، لكن الحماية تصبح أضعف.
# انظر SECURITY.md لشرح ما يفعّله كل متغير بالضبط.
#
# ⚠️ المفاتيح بلا بادئة VITE_ تُضبط في لوحة Cloudflare Pages → Settings →
# Environment variables (Production + Preview)، ولا تُوضع أبداً في .env.local
# ولا في الـ ZIP المنشور.

# مفتاح Turnstile العلني (يُدمج في حزمة المتصفح — ليس سرّاً).
# بلا هذا المفتاح لا تظهر ودجت التحقق في نموذج التعليقات.
VITE_TURNSTILE_SITE_KEY=

# المفتاح السري لـ Turnstile: يستعمله functions/api/comments.js للتحقق من
# الرمز عبر challenges.cloudflare.com/turnstile/v0/siteverify.
# إن بقي فارغاً يُتخطى التحقق تلقائياً (skipped) ولا يرفض المستخدمين.
TURNSTILE_SECRET_KEY=

# ملح لبصمة عنوان IP. لا يُخزَّن IP الخام في جدول comments، بل
# SHA-256(IP + هذا الملح) في عمود client_ip_hash.
# ضع قيمة عشوائية طويلة وثابتة (تغييرها لاحقاً يُبطل العدّادات القديمة فقط).
# مثال للتوليد: openssl rand -hex 32
IP_HASH_SALT=

# ── ربط KV لتحديد المعدل (اختياري لكن موصى به بشدة) ──
# بدونه يعمل تحديد المعدل من ذاكرة العامل (per-isolate) وهو تخفيف فقط وليس
# ضماناً، لأن Cloudflare يوزّع الطلبات على عُقد متعددة.
# الخطوات:
#   1) wrangler kv namespace create RATE_LIMIT
#   2) أضف إلى wrangler.toml / إعدادات Pages:
#        [[kv_namespaces]]
#        binding = "RATE_LIMIT_KV"
#        id = "<id>"
#   3) أعد النشر. الدوال تكتشف الربط تلقائياً وتستعمله.
RATE_LIMIT_KV=



# 🔐 6. CLERK AUTHENTICATION
VITE_CLERK_PUBLISHABLE_KEY=