# ==============================================================================
# Mizan Digital Environment Template
# Keep real secrets in local, ignored files only.
# ==============================================================================

# ── Canonical URLs ────────────────────────────────────────────────────────────
VITE_SITE_URL=https://www.mizan.page
VITE_APP_URL=https://www.mizan.page

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Cloudflare R2 Public Settings ─────────────────────────────────────────────
VITE_R2_ACCOUNT_ID=your_r2_account_id_here
VITE_R2_BUCKET_NAME=your_r2_bucket_name_here
VITE_R2_PUBLIC_URL=https://cdn.mizan.page


# ── Analytics & Monetization ─────────────────────────────────────────────────
VITE_GA_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXXX
VITE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# Legacy alias supported by older components; keep in sync with VITE_ADSENSE_CLIENT_ID.
VITE_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
VITE_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token

# ── Security & CAPTCHA ───────────────────────────────────────────────────────
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Legacy alias supported by older components; keep in sync with VITE_TURNSTILE_SITE_KEY.
VITE_CLOUDFLARE_SITE_KEY=your_turnstile_site_key_here

# ── Optional Backend Endpoints ────────────────────────────────────────────────
VITE_D1_API_URL=https://your-d1-api.example.com

# ── Local Admin Dev Only (do not use real production credentials) ────────────
VITE_ADMIN_USER=dev-admin@example.com
VITE_ADMIN_PASS=change-me