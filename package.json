{
  "name": "@mizan/static-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "clean": "node scripts/clean.mjs",
    "validate": "pnpm typecheck",
    "doctor": "node scripts/doctor.mjs",
    "prebuild": "node scripts/generate-counts.mjs && node scripts/generate-lexicon-client-data.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-feed.mjs && node scripts/generate-llms.mjs && node scripts/generate-llms-enhanced.mjs && node scripts/generate-reference.mjs",
    "build": "node scripts/clean.mjs && vite build --config vite.config.ts && node scripts/prerender.mjs && node scripts/enhance-schools-prerender.mjs && node scripts/enhance-lexicon-prerender.mjs && node scripts/csp-hashes.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run --configLoader runner",
    "tree": "node scripts/print-tree.mjs",
    "audit": "node scripts/audit-project.mjs",
    "icons:generate": "node scripts/generate-site-icons.mjs",
    "seo:enrich": "node scripts/enrich-lexicon.mjs",
    "seo:enrich:check": "node scripts/enrich-lexicon.mjs --check",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:audit:strict": "node scripts/seo-audit.mjs --strict",
    "seo:llms": "node scripts/generate-llms.mjs && node scripts/generate-llms-enhanced.mjs",
    "audit:unused": "knip",
    "knip": "knip"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "0.487.0",
    "pdfjs-dist": "^6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "^4.122.0"
  }
}
