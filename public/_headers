# Prevent browser from caching index.html
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Global headers & flexible CSP
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; font-src 'self' https: data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https: https://fonts.googleapis.com; frame-src 'self' https: https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net; connect-src 'self' https: wss: https://*.supabase.co; img-src 'self' data: blob: https:;